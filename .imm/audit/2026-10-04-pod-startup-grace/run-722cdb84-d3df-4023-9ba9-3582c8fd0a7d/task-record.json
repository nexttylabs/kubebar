{
  "contract": "assurance_kernel/task_record/v4",
  "task_id": "2026-10-04-pod-startup-grace",
  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-10-04-pod-startup-grace",
    "goal": "Kubebar must stop treating a young, still-initializing Pod as a readiness failure, so a routine Pod start no longer flips the cluster out of OK, no longer pulses the menu bar icon, and no longer sends a Health State Shift Alert. Pods inside a fixed 120 second startup grace that carry no failure signal are classified as starting, keep their honest non-ready row, report an N pods starting reason, and contribute zero to the cluster readiness deficit. Pods past the grace, and any Pod with a bad waiting reason, a CrashLoopBackOff, or a failed terminated container, keep their current Bad and Watch treatment. The Pods card keeps showing real ready over total, the OK/Watch/Bad/Stale vocabulary is unchanged, and no Settings surface is added.",
    "acceptance": [
      {
        "id": "A1",
        "assertion": "A Pod inside the startup grace with no failure signal is classified as starting, so its watched target reports OK with a starting reason.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/podInsideStartupGraceIsStartingNotNotReady\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A2",
        "assertion": "A not-ready Pod past the startup grace keeps its Watch classification with a not ready reason.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/notReadyPodPastGraceKeepsNotReadyClassification\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A3",
        "assertion": "A Pod inside the startup grace that has a bad waiting reason is still Bad.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/badWaitingReasonInsideGraceStaysBad\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A4",
        "assertion": "A Pod inside the startup grace that has a failed terminated container is still not-ready rather than starting.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/failedTerminatedContainerInsideGraceStaysBad\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A5",
        "assertion": "A Pod with no startTime and no creationTimestamp is treated as not-ready rather than starting.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/podWithoutAgeFieldsIsNotStarting\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A6",
        "assertion": "A watched target with only starting Pods reports OK while a target with a genuinely not-ready Pod reports Watch, and only the genuine case raises the alert severity.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"HealthEvaluatorStartupGraceTests/startingPodsKeepClusterOKAndSilent\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      },
      {
        "id": "A7",
        "assertion": "The startup classification uses status.startTime with a metadata.creationTimestamp fallback, a fixed 120 second grace, and a not-starting result for an unparsable age.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/startupGraceUsesStartTimeWithCreationTimestampFallback\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
      }
    ],
