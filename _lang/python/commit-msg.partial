# Detect test files in Python commits
PY_TEST_FILES=$(echo "$CHANGED_FILES" | grep -E '(^|/)test_[^/]+\.py$' || true)
PY_TEST_FILES2=$(echo "$CHANGED_FILES" | grep -E '_test\.py$' || true)
PY_TEST_DIRS=$(echo "$CHANGED_FILES" | grep -E '(^|/)tests/' | grep -E '\.py$' || true)

if [ -n "$PY_TEST_FILES" ] || [ -n "$PY_TEST_FILES2" ] || [ -n "$PY_TEST_DIRS" ]; then
  HAS_TESTS=1
else
  PY_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '\.py$' || true)
  if [ -n "$PY_SOURCE_FILES" ]; then
    for f in $PY_SOURCE_FILES; do
      if [ -f "$f" ]; then
        if grep -qE '\bdef test_|\bclass Test|@pytest|assert |\bpytest\.fixture' "$f" 2>/dev/null; then
          HAS_TESTS=1
          break
        fi
      fi
    done
  fi
fi
