# Detect test changes in Rust files
RS_TEST_DIRS=$(echo "$CHANGED_FILES" | grep -E '^tests/' || true)

if [ -n "$RS_TEST_DIRS" ]; then
  HAS_TESTS=1
else
  RS_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '\.rs$' || true)
  if [ -n "$RS_SOURCE_FILES" ]; then
    for f in $RS_SOURCE_FILES; do
      if [ -f "$f" ]; then
        if grep -qE '#\[(tokio::)?test\]|#\[cfg\(test\)\]|mod tests' "$f" 2>/dev/null; then
          HAS_TESTS=1
          break
        fi
      fi
    done
  fi
fi
