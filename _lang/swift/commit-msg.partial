# Detect test files in Swift commits
SWIFT_TEST_FILES=$(echo "$CHANGED_FILES" | grep -E '(^|/)(Tests|UITests)/.*\.swift$|(^|/)[^/]+(Tests|Spec|SnapshotTests)\.swift$' || true)

if [ -n "$SWIFT_TEST_FILES" ]; then
  HAS_TESTS=1
else
  SWIFT_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '\.swift$' || true)
  if [ -n "$SWIFT_SOURCE_FILES" ]; then
    for f in $SWIFT_SOURCE_FILES; do
      if [ -f "$f" ]; then
        if grep -qE 'XCTestCase|QuickSpec|assertSnapshot|SnapshotTesting|import XCTest' "$f" 2>/dev/null; then
          HAS_TESTS=1
          break
        fi
      fi
    done
  fi
fi
