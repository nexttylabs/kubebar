# Detect test files in Go commits
GO_TEST_FILES=$(echo "$CHANGED_FILES" | grep -E '_test\.go$' || true)
GO_TESTDATA=$(echo "$CHANGED_FILES" | grep -E '(^|/)testdata/' || true)
GO_TEST_PATTERNS=""

if [ -n "$GO_TEST_FILES" ] || [ -n "$GO_TESTDATA" ]; then
  HAS_TESTS=1
else
  GO_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '\.go$' || true)
  if [ -n "$GO_SOURCE_FILES" ]; then
    for f in $GO_SOURCE_FILES; do
      if [ -f "$f" ]; then
        if grep -qE '\bfunc Test|\bfunc Benchmark|\bt\.Run\(|\bt\.Helper\(' "$f" 2>/dev/null; then
          HAS_TESTS=1
          break
        fi
      fi
    done
  fi
fi
