# Detect test files in TypeScript commits
TS_TEST_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(test|spec)\.(ts|tsx)$' || true)
TS_TEST_DIRS=$(echo "$CHANGED_FILES" | grep -E '(^|/)(__tests__|tests)/' | grep -E '\.(ts|tsx)$' || true)
TS_TEST_PATTERNS=""

if [ -n "$TS_TEST_FILES" ] || [ -n "$TS_TEST_DIRS" ]; then
  HAS_TESTS=1
else
  TS_SOURCE_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(ts|tsx)$' || true)
  if [ -n "$TS_SOURCE_FILES" ]; then
    for f in $TS_SOURCE_FILES; do
      if [ -f "$f" ]; then
        if grep -qE '\bdescribe\(|\bit\(|\btest\(|\bexpect\(' "$f" 2>/dev/null; then
          HAS_TESTS=1
          break
        fi
      fi
    done
  fi
fi
