{
  "contract": "assurance_kernel/task_intent/v1",
  "task_id": "2026-10-04-pod-startup-grace",
  "goal": "Kubebar must stop treating a young, still-initializing Pod as a readiness failure, so a routine Pod start no longer flips the cluster out of OK, no longer pulses the menu bar icon, and no longer sends a Health State Shift Alert. Pods inside a fixed 120 second startup grace that carry no failure signal are classified as starting, keep their honest non-ready row, report an N pods starting reason, and contribute zero to the cluster readiness deficit. Pods past the grace, and any Pod with a bad waiting reason, a CrashLoopBackOff, or a failed terminated container, keep their current Bad and Watch treatment. The Pods card keeps showing real ready over total, the OK/Watch/Bad/Stale vocabulary is unchanged, and no Settings surface is added.",
  "acceptance": [
    {
      "id": "A1",
      "assertion": "A Pod inside the startup grace with no failure signal is classified as starting, so its watched target reports OK with a starting reason.",
      "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/podInsideStartupGraceIsStartingNotNotReady\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
    },
    {
      "id": "A2",
      "assertion": "A not-ready Pod past the startup grace keeps its Watch classification with a not ready reason.",
      "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"swift\",\n    \"argv\": [\"test\", \"--filter\", \"KubectlClusterReaderTests/notReadyPodPastGraceKeepsNotReadyClassification\", \"--quiet\"],\n    \"cwd\": \".\",\n    \"timeout_ms\": 240000,\n    \"max_output_bytes\": 262144\n  },\n  \"environment\": {\"prepare\": null, \"writable_paths\": [\".build\"]}\n}\n"
    },
    {
      "id": "A3",
      "assertion": "A Pod inside the startup grace that has a bad waiting reason is still Bad.",
